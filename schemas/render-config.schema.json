{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rick-mation/schemas/render-config.schema.json",
  "title": "RenderConfig",
  "description": "render_config.json. Drives Remotion/FFmpeg render invocation. See references/09-remotion-implementation.md and references/01-system-architecture.md (Versioning).",
  "type": "object",
  "required": ["mode", "fps", "width", "height", "output"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["preview", "review", "final"]
    },
    "fps": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "output": { "type": "string" },
    "scene_range": {
      "type": "object",
      "description": "Optional partial re-render addressing (render --scene / --from / --to).",
      "properties": {
        "scene": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "versioning": {
      "type": "object",
      "description": "Recorded for reproducibility on every run.",
      "properties": {
        "planner_model_id": { "type": "string" },
        "tts_voice_id": { "type": "string" },
        "prompt_version": { "type": "string" },
        "storyboard_version": { "type": "string" },
        "design_system_version": { "type": "string" },
        "component_library_version": { "type": "string" },
        "source_asset_hashes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
